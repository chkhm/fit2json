# ── Rust / Cargo ─────────────────────────────────────────────────────────────

# Compiled output and build artefacts
/target/
debug/

# rustfmt backup files
**/*.rs.bk

# MSVC debug-info files (Windows builds)
*.pdb

# cargo-mutants output
**/mutants.out*/


# ── Personal FIT data ────────────────────────────────────────────────────────
# FIT files contain personal GPS tracks, health metrics, and device data.
# Keep them local — use your own files for testing.

**/*.fit
test-data/


# ── Derived / exported data files ────────────────────────────────────────────
# JSON / compressed exports generated during development; may contain
# personal activity data.

parsed_content*.json
profile.json.gz
*.json.gz


# ── Test results derived from personal data ──────────────────────────────────
# Survey outputs reference file counts, dates, and sizes from personal exports.

test-results/


# ── Claude Code ──────────────────────────────────────────────────────────────
# Local session history, worktrees, and plans managed by Claude Code CLI.

.claude/


# ── IDEs and editors ─────────────────────────────────────────────────────────

# JetBrains (RustRover, IntelliJ, CLion, …)
.idea/

# VS Code
.vscode/

# Vim / Neovim swap files
*.swp
*.swo

# Emacs backup files
*~


# ── macOS ─────────────────────────────────────────────────────────────────────

.DS_Store
.AppleDouble
.LSOverride

# Thumbnail cache
._*


# ── Microsoft Office temp files ──────────────────────────────────────────────

~$*
*.xlsx
*.xlsm


# ── Archives and compressed files (likely data exports) ──────────────────────

*.zip
*.gz
*.tar
*.tar.gz
*.tgz
